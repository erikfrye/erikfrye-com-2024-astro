---
import SocialLinks from './SocialLinks.astro';
---

<section id="hero" class="min-h-screen flex items-center pt-20 pb-16 md:pb-24">
  <div class="container-custom">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="taos:translate-x-[-200px] taos:opacity-0" data-taos-offset="300">
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold mb-6">
          <span class="block dark:text-dark-text text-light-text">Hi, I'm</span>
          <span class="block text-light-primary dark:text-dark-primary">Erik Frye</span>
        </h1>
        <h2 class="text-xl sm:text-2xl mb-6 font-medium text-light-text dark:text-dark-text">
          Senior People Leader bridging creativity and technology
        </h2>
        <p class="text-dark-300 text-dark dark:text-light-400 max-w-xl mb-8">
          I'm a resourceful and ambitious leader with a passion for developing effective teams 
          and interactive digital experiences. I excel at connecting creative solutions with 
          technical execution, coaching high-performing teams, and thriving in dynamic environments.
        </p>
        
        <div class="flex flex-wrap gap-4">
          <a href="#contact" class="btn btn-primary">
            Let's Connect
          </a>
          <a href="#projects" class="btn btn-outline">
            View My Work
          </a>
        </div>
        
        <div class="mt-8">
          <SocialLinks />
        </div>
      </div>
      
      <div class="hidden lg:block taos:translate-x-[200px] taos:opacity-0" data-taos-offset="300">
        <div class="relative">
          <div class="absolute -inset-0.5 bg-gradient-to-r from-primary-600 to-secondary-600 rounded-full blur opacity-70"></div>
          <div class="relative bg-light-100 dark:bg-dark-200 rounded-full p-2">
            <img 
              src="src/assets/erik-profile-photo.jpg" 
              alt="Erik Frye Headshot" 
              class="w-full rounded-full shadow-lg"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>