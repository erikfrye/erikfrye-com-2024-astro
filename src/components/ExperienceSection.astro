---
const experiences = [
  {
    id: 1,
    role: "Senior Frontend Developer",
    company: "Tech Innovations Inc.",
    period: "2021 - Present",
    description: "Lead the development of the company's flagship product, implementing new features and improving performance. Mentored junior developers and introduced best practices for code quality.",
    technologies: ["React", "TypeScript", "GraphQL", "Tailwind CSS"],
    logo: "https://images.pexels.com/photos/1643383/pexels-photo-1643383.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=2"
  },
  {
    id: 2,
    role: "Frontend Developer",
    company: "Digital Solutions Agency",
    period: "2018 - 2021",
    description: "Worked on various client projects, building responsive web applications and e-commerce solutions. Collaborated with designers to implement pixel-perfect UI components.",
    technologies: ["JavaScript", "React", "Node.js", "SCSS"],
    logo: "https://images.pexels.com/photos/1337247/pexels-photo-1337247.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=2"
  },
  {
    id: 3,
    role: "Junior Web Developer",
    company: "StartUp Ventures",
    period: "2016 - 2018",
    description: "Assisted in the development of web applications for early-stage startups. Learned modern development practices and gained experience in full-stack development.",
    technologies: ["HTML/CSS", "JavaScript", "PHP", "MySQL"],
    logo: "https://images.pexels.com/photos/3888149/pexels-photo-3888149.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=2"
  }
];
---

<section id="experience" class="py-20">
  <div class="container-custom">
    <h2 class="text-center text-3xl font-bold text-gray-900 dark:text-white mb-16 taos:scale-[0.6] taos:opacity-0" data-taos-offset="300">
      Work Experience
    </h2>

    <div class="relative max-w-4xl mx-auto">
      <!-- Timeline Vertical Line -->
      <div class={`absolute top-0 left-[22px] md:left-1/2 w-[3px] h-full bg-light-primary/20 dark:bg-dark-primary/20 md:-translate-x-1/2 z-0`}></div>

      {experiences.map((exp, index) => (
        <div
          class={`relative mb-16 md:w-1/2 taos:translate-y-[200px] taos:opacity-0
            ${index % 2 === 0 
              ? 'ml-auto md:pr-12 md:text-right md:translate-x-[-33px]' 
              : 'mr-auto md:pl-12 md:text-left md:translate-x-[38px]'
            } transition-transform duration-300`}
          data-taos-offset="300"
          data-taos-delay={index * 200}
        >
          <!-- Timeline Dot -->
          <div class={`absolute top-0 left-[22px] ${index % 2 === 0 ? 'md:left-[33px]' : 'md:left-auto md:right-[18px]'} transform -translate-x-1/2 -translate-y-1/2 z-10`}>
            <div class="w-5 h-5 rounded-full bg-light-primary dark:bg-dark-primary shadow-md ring-2 ring-white/70 dark:ring-white/30 flex items-center justify-center">
              <div class="w-2.5 h-2.5 bg-white dark:bg-dark-100 rounded-full"></div>
            </div>
          </div>

          <!-- Glass Card -->
          <div class={`relative z-10 mt-6 md:mt-0 card ${index % 2 === 0 ? 'md:mr-8' : 'md:ml-8'}`}>
            
            <div class="p-6">
              <!-- Header -->
              <div class="flex items-center gap-4 mb-3">
                <div class="w-12 h-12 rounded-full overflow-hidden bg-white/30 dark:bg-white/10 flex items-center justify-center">
                  <img 
                    src={exp.logo}
                    alt={`${exp.company} logo`} 
                    class="w-full h-full object-contain"
                  />
                </div>
                <div>
                  <h3 class="text-lg font-semibold text-gray-900 dark:text-white">{exp.role}</h3>
                  <p class="text-sm text-gray-700 dark:text-gray-300">{exp.company}</p>
                </div>
              </div>

              <!-- Period -->
              <div class="text-xs font-medium text-gray-500 dark:text-gray-400 mb-2">
                {exp.period}
              </div>

              <!-- Description -->
              <p class="text-sm text-gray-800 dark:text-gray-200 mb-4 leading-relaxed">
                {exp.description}
              </p>

              <!-- Tech Badges -->
              <div class="flex flex-wrap gap-2">
                {exp.technologies.map(tech => (
                  <span class="tag">
                    {tech}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>